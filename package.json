{
  "name": "face-age-history-server",
  "version": "1.0.0",
  "description": "Self-hosted scan history server for the face-age skin analysis SDK. Store skin age and skin health results per shopper, restore them on any device, and power the Compare tab without building your own backend.",
  "keywords": [
    "face-age",
    "skin-analysis",
    "skin-age",
    "scan-history",
    "face-scan",
    "skincare",
    "beauty-sdk",
    "self-hosted",
    "gdpr",
    "compare-scans",
    "fastify",
    "prisma",
    "sqlite"
  ],
  "author": "milad mostafa",
  "license": "MIT",
  "homepage": "https://getfaceage.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miladmostafa/face-age-history-server.git"
  },
  "bugs": {
    "url": "https://github.com/miladmostafa/face-age-history-server/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helper": {
      "types": "./dist/helper/index.d.ts",
      "import": "./dist/helper/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node scripts/prepare-database.mjs && tsx watch src/index.ts",
    "build": "prisma generate && tsc && node scripts/build-helper.mjs",
    "start": "node scripts/prepare-database.mjs && node dist/index.js",
    "test": "DATABASE_URL=file:./data/prisma-generate.db prisma generate && vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/prepare-database.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "prisma": "^6.16.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
