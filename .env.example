# Copy to .env.local and fill in real values. Never commit secrets.

# Required. Sent by the browser helper as X-Api-Key or Authorization: Bearer.
API_KEY=replace-with-a-long-random-string

# Required. Encrypts scan payloads at rest (AES-256-GCM). Use a long random secret.
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret

# SQLite file (default) or a Postgres URL:
# postgresql://faceage:faceage@postgres:5432/history?schema=public
DATABASE_URL=file:./data/history.db

PORT=3000
HOST=0.0.0.0

# Drop scans older than this many days. 0 keeps scans until you delete them.
RETENTION_DAYS=365
MAX_SCANS_PER_USER=50
MAX_PAYLOAD_BYTES=200000

# Facial photos are never stored unless this is true, and even then only http(s) URLs.
STORE_IMAGES=false

# Comma-separated browser origins, or * for a private local deployment.
CORS_ORIGIN=*

# Serves the demo page at /. Turn this off on a public server so the API key
# is not embedded in HTML.
DEMO_ENABLED=true

# Face Age Client ID from https://panel.getfaceage.com/ — required only for the demo widget.
# Leave blank in git. Put the real value in .env.local.
FACEAGE_CLIENT_ID=

LOG_LEVEL=info
RATE_LIMIT_MAX=120
